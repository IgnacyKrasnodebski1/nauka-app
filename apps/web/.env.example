# --- Supabase (brak = tryb demo: biblioteka z @nauka/content, postępy w localStorage, API zwraca 503) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (brak ANTHROPIC_API_KEY = generowanie w trybie demo, tutor odpowiada na sucho) ---
ANTHROPIC_API_KEY=
RECALL_AI_MODEL=claude-opus-5   # (alias: NAUKA_AI_MODEL)
# RECALL_AI_FIX_MODEL=claude-sonnet-5   # model review pytań
# TUTOR_ENABLED=1   # /api/tutor w buildzie produkcyjnym (domyślnie 410 — otwarty proxy do Opusa, AUDYT P1-1)

# --- Media Cramfox: rolki, podcast „Lis i Szop”, rozmowa z lisem (backend/0010; docs/API.md „Media i rozmowa z lisem”) ---
# Brak ELEVENLABS_API_KEY = rolki i podcast wyłączone (503 tts_unavailable, features.reels=false). Brak głosów lisa / szopa =
# podcast wyłączony (503 voices_missing, features.podcast=false). Rozmowa z lisem potrzebuje tylko ANTHROPIC_API_KEY.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_REEL=          # lektor rolek (domyślnie głos „Dawid”)
ELEVENLABS_VOICE_FOX=
ELEVENLABS_VOICE_SZOP=
# ELEVENLABS_REEL_MODEL=eleven_v4
# ELEVENLABS_PODCAST_MODEL=eleven_flash_v2_5
# ELEVENLABS_REEL_TAGS=1          # 0 = bez znaczników [excited] itd. w narracji rolek
# CRAMFOX_MEDIA_MODEL=claude-sonnet-5   # scenariusze rolek i podcastu
# CRAMFOX_FOX_MODEL=claude-sonnet-5     # rozmowa z lisem

# --- Stripe (brak = przyciski "Przejdź na Pro" zwracają 503) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
