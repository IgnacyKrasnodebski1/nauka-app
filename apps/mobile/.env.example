# Skopiuj do .env (Expo wczytuje .env automatycznie; zmienne EXPO_PUBLIC_* trafiają do bundla — NIGDY nie wrzucaj tu sekretów).
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Adres weba (apps/web) — tam żyje API: /api/generate, /api/tutor, /api/me, /api/stripe/checkout
EXPO_PUBLIC_API_URL=http://localhost:3000
# opcjonalnie — projectId z expo.dev (po `eas init`)
EAS_PROJECT_ID=
